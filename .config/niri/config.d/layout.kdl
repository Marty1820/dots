//--- Layout ---
// https://niri-wm.github.io/niri/Configuration%3A-Layout.html
layout {
  gaps 4
  center-focused-column "never"
  always-center-single-column
  background-color "transparent"
  default-column-display "normal"

  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
  }

  default-column-width {}

  preset-window-heights {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
  }

  focus-ring {
    width 1
    active-gradient from="#9ece6a" to="#9d7cd8" angle=45 in="oklch longer hue"
    inactive-gradient from="#565f89" to="#1a1b26" angle=45 relative-to="workspace-view"
    urgent-gradient from="#f7768e" to="#ff9e64" angle=45
  }

  border { off; }
  insert-hint {
    on
    color "#ff9e64"
    gradient from="#ff9e64" to="#7dcfff" angle=45 relative-to="workspace-view"
  }
}

{
  // Module Configurations
  "backlight": {
    "format": "{icon} {percent}",
    "format-icons": [
      "󰃚",
      "󰃛",
      "󰃜",
      "󰃝",
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "min-brightness": 1,
    "tooltip": false
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}",
    "format-full": "{icon} {capacity}",
    "format-charging": "󰂄 {capacity}",
    "format-plugged": " {capacity}",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "format-connected-battery": " {device_battery_percentage}",
    "on-click": "blueman-manager &",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}"
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "first-day-of-week": 1,
      "on-scroll": 1
    },
    "format-alt": "{:%Y %b %d}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰈈",
      "deactivated": "󰈉"
    },
    "tooltip": false
  },
  "network": {
    "format-ethernet": "󰈀",
    "format-wifi": "{icon} {essid}",
    "format-disconnected": "󰤮",
    "format-disabled": "󰀝",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "on-click": "nm-connection-editor &",
    "tooltip-format": "Strength: {signalStrength}\nIP: {ipaddr}\nFreq: {frequency}",
    "tooltip-format-ethernet": "IP: {ipaddr}\nLinkSpd: {linkSpeed}",
    "tooltip-format-disabled": "Airplane Mode"
  },
  "niri/window": {
    "format": "{}",
    "rewrite": {
      "(.*) — Zen Browser": "$1",
      "v (.*)": "Neovim $1"
    }
  },
  "wireplumber": {
    "format": "{icon} {volume}",
    "format-muted": " {volume}",
    "format-bluetooth": "󰥰 {volume}",
    "format-icons": {
      "headphone": "",
      "default": [
        "",
        "",
        "",
        ""
      ]
    },
    "tooltip": false,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "custom/power": {
    "format": "⏻ ",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
    "menu-actions": {
      "hibernate": "systemctl hibernate",
      "reboot": "systemctl reboot",
      "shutdown": "systemctl poweroff"
    }
  },
  "custom/aqi": {
    "on-click": "xdg-open https://aqicn.org/here",
    "exec": "$HOME/.config/waybar/scripts/aqi-waybar.py",
    "interval": 120,
    "return-type": "json"
  },
  "custom/weather": {
    // "on-click": "xdg-open https://",
    "exec": "$HOME/.config/waybar/scripts/weather-waybar.py",
    "interval": 120,
    "return-type": "json"
  }
}
